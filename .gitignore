# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Environments ---
.venv/
venv/
env/
.env

# --- Experiment outputs ---
# Never commit these: they are large, regenerable, and cause merge conflicts.
results/
checkpoints/
outputs/
logs/
wandb/
lightning_logs/
multirun/
*.ckpt
*.pt
*.pth

# --- Cached data ---
# Datasets and eigendecompositions are regenerated by scripts/, not versioned.
# Ignore the contents, not the directory: an ignored directory cannot be re-included by a
# later negation, so `data/` would make `!data/.gitkeep` unreachable.
data/*
!data/.gitkeep
third_party/

# --- Compiled binaries ---
# ORCA is built locally per platform.
*.exe
*.out
src/eval/orca/orca

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
